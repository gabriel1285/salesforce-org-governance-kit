<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>The only place the bypass custom permissions are granted. Assign temporarily for data loads or controlled fixes, then remove. Also manages the automation error log.</description>
    <customPermissions>
        <enabled>true</enabled>
        <name>Bypass_Automation</name>
    </customPermissions>
    <customPermissions>
        <enabled>true</enabled>
        <name>Bypass_Validation_Rules</name>
    </customPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Automation_Error_Log__c.Error_Message__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Automation_Error_Log__c.Flow_Name__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Automation_Error_Log__c.Record_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Automation Admin (bypass)</label>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Automation_Error_Log__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
</PermissionSet>
